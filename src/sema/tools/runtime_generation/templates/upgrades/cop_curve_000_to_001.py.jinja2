    def upgrade(self) -> {{ cop_curve_001_class_name }}:
        """
        - Lift-based model: Intercept + LwtMinusOatCoeff * max(0, LwtF - OatF);
          OatCoeff, LwtCoeff, Min, MinOatF dropped. A 000 is a different fit
          and does not upgrade.
